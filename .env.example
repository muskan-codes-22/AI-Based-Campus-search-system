# ==============================================================================
# Campus AI Study Assistant & RAG System - Environment Configuration
# ==============================================================================

# Get your free NVIDIA API Key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# Fast, high-throughput generative model (< 3s latency)
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Local Storage Paths
DATA_DIR=data
CHROMA_DIR=chroma_db
COLLECTION_NAME=pdf_knowledge_base

# Dense Embeddings & Chunking Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# Hybrid Retrieval (BM25 + Dense Chroma + Reciprocal Rank Fusion)
VECTOR_TOP_K=60
BM25_TOP_K=80
FINAL_TOP_K=15
RRF_K=60
MAX_CONTEXT_CHARS=25000

